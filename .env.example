NODE_ENV="development"
PORT=5000
CLIENT_URL="http://localhost:3030"

# Postgres. On serverless (Vercel) use the pooled Neon URL; use the direct URL for migrations.
DATABASE_URL="postgresql://DB_USER:DB_PASS@HOST/DB_NAME?sslmode=require"

# Auth
JWT_SECRET="GENERATE_A_LONG_RANDOM_STRING"
EXPIRES_IN="30d"
REFRESH_TOKEN_SECRET="GENERATE_A_LONG_RANDOM_STRING"
REFRESH_TOKEN_EXPIRES_IN="30d"
RESET_PASS_TOKEN="GENERATE_A_LONG_RANDOM_STRING"
RESET_PASS_TOKEN_EXPIRES_IN="5m"
RESET_PASS_LINK="http://localhost:3030/reset-password"

# Mail (Gmail app password)
EMAIL="YOUR_EMAIL"
APP_PASS="YOUR_GMAIL_APP_PASSWORD"

# Cloudinary - product and shop image uploads
CLOUDINARY_CLOUD_NAME="YOUR_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_API_KEY"
CLOUDINARY_API_SECRET="YOUR_API_SECRET"

# SSLCommerz
STORE_ID="SSL_STORE_ID"
STORE_PASS="SSL_STORE_PASSWORD"
SSL_PAYMENT_API="https://sandbox.sslcommerz.com/gwprocess/v4/api.php"
SSL_VALIDATIOIN_API="https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php"
SUCCESS_URL="http://localhost:3030/success"
CANCEL_URL="http://localhost:3030/cancel"
FAIL_URL="http://localhost:3030/fail"

# Aamarpay
AMARPAY_STORE_ID="AAMARPAY_STORE_ID"
AMARPAY_SIGNATURE_KEY="AAMARPAY_SIGNATURE_KEY"
